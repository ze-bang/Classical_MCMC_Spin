Thumbs.db

# ============================================================================
# Simulation outputs and research data
#
# These directories hold the outputs of individual project runs (HDF5
# trajectories, spin snapshots, per-trial dirs, etc.). They can be tens of GB
# and should not be committed to the source repository.
# ============================================================================
local_runs/
logs/
NCTO_gneb_ensemble/
gneb_ensemble/
patch_seeds/
patch_lifetime/
tiled_3Q_configs/
tiled_zz_configs/

# Project workspaces that accumulate results next to analysis scripts.
# Source scripts are still tracked explicitly via `!` rules below.
TFO_project/**/results/
TFO_project/**/*.h5
TFO_project/**/*.hdf5

# Data / large binary output
*.h5
*.hdf5
*.npy
*.npz
*.pt
*.pth
*.pkl
*.pickle

# Log & profiler output (keep README / text notes)
*.log
*.prof
*.gprof
# Match root-level core-dump files only — `core` alone would also
# swallow `src/core/`, hiding every new C++ TU placed there.
/core
core.[0-9]*

# Research output / scratch directories — large simulation data,
# notes, plots; not source. Add specific subpaths back with
# `!path` if anything in them is worth tracking.
TFO_project/
tfo_project/
NCTO_kruger2023_3Q_SA/
output/

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.synctex.gz
*.toc
*.out
*.dvi
# NOTE: we intentionally do NOT ignore *.pdf — some PDFs (figures, reports)
# are deliberately tracked in the repo.

# ============================================================================
# Vendored dependencies that are not (yet) wired into the build
# ============================================================================
# `Einsums/` is a vendored copy of the einsums tensor-contraction library
# but no `CMakeLists.txt` or C++/CUDA source currently references it. Keep it
# out of the repository until it is either removed or added to the build.
Einsums/

# ============================================================================
# Whitelist: keep committed configuration files that would otherwise be caught
# ============================================================================
!example_configs/**
!docs/**
!gneb_ensemble/*.param

# ============================================================================
# Re-exclusions (must come AFTER the !example_configs/** whitelist so they
# actually take effect). These are heavily generated parameter sweeps that
# would otherwise drown the repo in near-duplicate configs.
# ============================================================================
example_configs/NCTO_strain/
example_configs/TmFeO3/
example_configs/Kitaev/pt_gradient_test.param
example_configs/test_correlation_accumulator.param

# ============================================================================
# Research-project material -- NOT part of the library
# ----------------------------------------------------------------------------
# This repository is the generic classical-spin Monte Carlo / molecular
# dynamics engine. Compound-specific campaigns (manuscripts, sweep configs,
# derivation notes, per-compound analysis scripts and their data) live in the
# private per-project repositories, not here. The files may still sit in a
# working copy -- they are simply never committed.
#
# These rules come AFTER the !example_configs/** and !docs/** whitelists above
# so they actually take effect.
# ============================================================================

# Campaign / manuscript trees
TmFeO3_manuscript/
TmFeO3_manuscript_pre_*/
TmFeO3_temperature_and_orbitals/
TmFeO3_temperature_and_orbitals.tar.gz
NCTO_project_paper/
NCTO_phonon_v0/
NCTO_phonon_*/

# Loose research output at the repository root
disorder_pinned_droplet_lifetime.pdf
disorder_pinned_droplet_lifetimeNotes.bib
reference_Efield*.zip

# Compound-specific run configurations
example_configs/BCAO/
example_configs/TmFeO3*/
example_configs/NCTO*/

# Compound-specific derivation notes and figures
docs/tmfeo3_*
docs/ncto_*
docs/bcao_*
docs/kcto_*
docs/chi_activity_table.*
docs/chi_bonds_3d_structure.*
docs/chi_fe_frames.*
docs/chi_tm_frames.*

# Compound-specific analysis / reader scripts
util/*tmfeo3*
util/aux/*tmfeo3*
util/aux/visualize_TmFe_coupling.py
util/classical_solvers/bcao_*
util/classical_solvers/*_BCAO.py
util/readers/reader_TmFeO3.py
util/readers_new/reader_TmFeO3*
