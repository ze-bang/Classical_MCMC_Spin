# TmFeO3 2DCS — Geometry I (H || a, E || c, VV)
#
# Pump:  THz pulse with H||a, E||c.
#        Magnetic drive J_x^eff = 2.39 lambda^5 + 0.91 lambda^7  (auto from mu_act)
#        Electric drive d_z^eff ~ lambda^{4,6}  (NOT applied — see plan §2)
# Detection (post-process from M_global):
#        VV ⇒ E_det || c, H_det || a (Faraday geometry, propagation along b)
#        Read M_global_SU2[0]  (Fe magnetic, M_x^Fe → qFM/qAFM emission along c)
#             M_global_SU3[3,5] (Tm electric d_z^eff → c-polarized)
#             M_global_SU3[4,6] (Tm magnetic J_x^eff → a-polarized; sub-leading in VV)
#
# Expected dominant peaks (notes Sec. sec:geomI):
#   (E1→E2, 0)            — population grating          [from λ^{3,8} after [λ5,λ7]=iλ2]
#   (E1→E2, E2→E3)        — pulse-B re-conversion       [M_13 = 2.39, large]
#   (E1→E2, qFM)          — A1+ Van Vleck back-action   [requires W1_xx, W1_zz ≠ 0]
#   (E1→E2, E1→E3)        — pulse-B re-conversion       [M_23 = 0.91, smaller]
# Subleading:
#   (qAFM, E1→E3)         — Fe-first two-step pathway

# === Simulation Type ===
system = tmfeo3
simulation_mode = 2dcs

# === Lattice (smoke-test size; bump to 8×8×8 for production) ===
lattice_size = 3,3,3

# === Frame mode (Fe sector) ===
# use_global_frame = 1: Fe spins stored in the laboratory frame; Fe-Fe exchange
#   and Zeeman are lab-form; Fe-Tm chi / W / V tensors are premultiplied on the
#   Fe side by the Pbnm eta pattern so they match the canonical local-frame
#   definitions (see unitcell_builders.cpp and test_global_frame_equivalence.cpp).
# Tm sublattice CEF frames are always local (independent of this flag).
use_global_frame = 1

# === Fe sector — Bertaut/White conventions, calibrated for Γ_2 ground state ===
# Retuned using 4-sublattice q=0 LSWT with local sublattice frames, then validated
# against the full mixed 3×3×3 C++ Hamiltonian/readout in global F/G channels.
# Gamma_2 expectation: H||a excites the hidden qAFM branch (mostly staggered,
# visible in global F only via DM/crosspeaks), while H||c excites qFM in global F.
# Best validated grid point: Ka=-0.016, Kc=-0.013 gives qFM≈0.376 THz (global Fz)
# and qAFM≈0.893 THz (staggered AFy) in the production Hamiltonian.
J1ab = 4.74
J1c  = 5.15
J2ab = 0.15
J2c  = 0.30
Ka   = -0.016
Kb   =  0.0
Kc   = -0.013
D1   =  0.12
D2   =  0.0

# === Tm CEF ===
# Diagonal SU(3) field is alpha = e1, beta = (2 e2 - e1)/sqrt(3) on (lambda^3, lambda^8).
# Quantum gaps of H_CEF are 2e1, 2(e2-e1), 2e2.  However the C++ Bloch EOM
# computes d_i = f_{ijk} H_j S_k (no factor of 2 from [lambda^a, lambda^b] = 2i f^{abc} lambda^c),
# so the simulated coherence frequencies are HALF the quantum gaps:
#     omega_{12} = e1     (E_1 <-> E_2)
#     omega_{23} = e2-e1  (E_2 <-> E_3)
#     omega_{13} = e2     (E_1 <-> E_3)            [in meV; multiply by 0.241799 for THz]
# Verified empirically against the OLD (e1=0.96, e2=3.92) run, which gave 0.232/0.721/0.953 THz.
# User targets (0.500, 0.700, 1.200 THz) => e1 = 2.069 meV, e2 = 4.965 meV.
e1 = 2.069
e2 = 4.965
tm_alpha_scale = 1.0
tm_beta_scale  = 1.0

# === Tm projected magnetic moment (Skorobogatov 2020) ===
mu_2x = 0.0
mu_2y = 0.0
mu_2z = 5.264
mu_5x = 2.3915
mu_5y = -2.7866
mu_5z = 0.0
mu_7x = 0.9128
mu_7y = 0.4655
mu_7z = 0.0
g_ratio_tm = 0.5833

# === Tm-Fe linear transfer (only λ^2 ↔ G_z survives the q=0 cancellation) ===
chi2x = 0.0
chi2y = 0.0
chi2z = 0.05
chi5x = 0.0
chi5y = 0.0
chi5z = 0.0
chi7x = 0.0
chi7y = 0.0
chi7z = 0.0

# === On-site anisotropy-modulation trilinear W{a}_{bc} (microscopic names in code) ===
# Legacy shorthand u1 → W1_zz = +u1, W1_xx = -u1 (Γ2 projection; see unitcell_builders.cpp).
# Other W/V channels default to 0 if omitted.
W1_xx = -0.005
W1_zz =  0.005

# === Tm-Tm — diagonal NN, off ===
Jtm_1 = 0.0
Jtm_2 = 0.0
Jtm_3 = 0.0
Jtm_4 = 0.0
Jtm_5 = 0.0
Jtm_6 = 0.0
Jtm_7 = 0.0
Jtm_8 = 0.0

# === Static field (off) ===
field_strength  = 0.0
field_direction = 1,0,0

# === Equilibration ===
T_start = 20.0
T_end   = 0.05
annealing_steps = 10000
overrelaxation_rate = 1
use_twist_boundary = false
gaussian_move = false
T_zero = true

# Spin lengths
spin_length     = 2.5
spin_length_su3 = 1.0

# === Pump (Geometry I: H || a) — SU3 drive DISABLED for this run ===
# auto_su3_pump = 0 ⇒ do NOT project the 3D h vector onto Tm Gell-Mann channels.
# pump_amplitude_su3 = 0 ⇒ Tm sublattice receives no direct pulse; only Fe (SU2)
# is excited.  Tm dynamics enter only through Tm-Fe coupling (chi, W, V).
auto_su3_pump  = 0
pump_direction = 1,0,0
pump_amplitude = 0.30
pump_width     = 0.40
pump_frequency = 0.40

pump_amplitude_su3 = 0.0
pump_width_su3     = 0.40
pump_frequency_su3 = 0.40

# === 2DCS scan ===
# Convention: pump at t=0, probe at t=tau.  With tau ∈ [-100, 0] (tau_step < 0)
# the FIRST pulse fires at t = tau (negative time, before the pump) and the
# SECOND pulse fires at t = 0, then detection runs out to t = +md_time_end.
# This matches the user's experimental convention: pulse-1 at -|τ|, pulse-2 at 0.
#
# Resolution targets:
#   τ window 100 ps  →  Δω_τ = 1/100 ps ≈ 0.010 THz
#   τ step  0.02 ps  →  ω_τ Nyquist = 25 THz
#   t window 200 ps  →  Δω_t = 1/200 ps ≈ 0.005 THz
#   t step  0.02 ps  →  ω_t Nyquist = 25 THz
tau_start = 0.0
tau_end   = -100.0
tau_step  = -0.02              # 5001 tau values, walking from 0 down to -100
parallel_tau = true
num_trials   = 1

# === Time evolution ===
# Full ±100 ps window so we capture the most-negative pulse-1 at t = -100 and
# 100 ps of free-evolution tail after pulse-2.
md_time_start = -100.0
md_time_end   =  100.0
md_timestep   = 0.02
md_integrator = rk4
use_gpu = false

# === Output ===
output_dir = TmFeO3_2DCS_geomI
save_observables = false
