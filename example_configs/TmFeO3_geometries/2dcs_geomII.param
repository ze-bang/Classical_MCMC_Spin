# TmFeO3 2DCS — Geometry II (H || a, E || c, VH)
#
# Pump:  identical to Geometry I (THz pulse with H||a, E||c).
#        Magnetic drive J_x^eff = 2.39 lambda^5 + 0.91 lambda^7  (auto from mu_act)
#        Electric drive d_z^eff ~ lambda^{4,6}  (NOT applied — see plan §2)
# Detection (post-process from M_global):
#        VH ⇒ E_det || a, H_det || c   (orthogonal to pump)
#        Read M_global_SU2[2]  (Fe magnetic, M_z^Fe → a-polarized radiation)
#             M_global_SU3[0]  (Tm electric d_x^eff → a-polarized; the dominant Tm channel)
#             M_global_SU3[1]  (Tm magnetic J_z^eff → c-polarized; sub-leading)
#
# Expected dominant peaks (notes Sec. sec:geomII):
#   (qAFM, E1→E2)         — direct linear-exchange route   [chi_2z·G_z·λ^2]
#   (0,    E1→E2)         — rectified Fe transient → even Tm
# Extension-required (NOT in minimal model):
#   (qAFM, E1→E3)         — needs polarization leakage from biaxial host

# === Simulation Type ===
system = tmfeo3
simulation_mode = 2dcs

lattice_size = 3,3,3
# Fe global lab frame + corrected Fe-Tm eta premultiplication; see 2dcs_geomI.param.
use_global_frame = 1

# === Fe sector — see geomI for retuning rationale ===
J1ab = 4.74
J1c  = 5.15
J2ab = 0.15
J2c  = 0.30
Ka   = -0.016
Kb   =  0.0
Kc   = -0.013
D1   =  0.12
D2   =  0.0

# === Tm CEF (see geomI for derivation) — match user targets 0.50/0.70/1.20 THz ===
e1 = 2.069
e2 = 4.965
tm_alpha_scale = 1.0
tm_beta_scale  = 1.0

# === Tm projected magnetic moment ===
mu_2x = 0.0
mu_2y = 0.0
mu_2z = 5.264
mu_5x = 2.3915
mu_5y = -2.7866
mu_5z = 0.0
mu_7x = 0.9128
mu_7y = 0.4655
mu_7z = 0.0
g_ratio_tm = 0.5833

# === Tm-Fe linear transfer ===
chi2x = 0.0
chi2y = 0.0
chi2z = 0.05
chi5x = 0.0
chi5y = 0.0
chi5z = 0.0
chi7x = 0.0
chi7y = 0.0
chi7z = 0.0

# === On-site W (legacy u1 → W1_zz = +u1, W1_xx = -u1) ===
W1_xx = -0.005
W1_zz =  0.005

# === Tm-Tm: zero ===
Jtm_1 = 0.0
Jtm_2 = 0.0
Jtm_3 = 0.0
Jtm_4 = 0.0
Jtm_5 = 0.0
Jtm_6 = 0.0
Jtm_7 = 0.0
Jtm_8 = 0.0

# === Static field ===
field_strength  = 0.0
field_direction = 1,0,0

# === Equilibration ===
T_start = 20.0
T_end   = 0.05
annealing_steps = 10000
overrelaxation_rate = 1
use_twist_boundary = false
gaussian_move = false
T_zero = true

spin_length     = 2.5
spin_length_su3 = 1.0

# === Pump (Geometry II: H || a, same as Geom I) — SU3 drive DISABLED ===
auto_su3_pump  = 0
pump_direction = 1,0,0
pump_amplitude = 0.30
pump_width     = 0.40
pump_frequency = 0.40

pump_amplitude_su3 = 0.0
pump_width_su3     = 0.40
pump_frequency_su3 = 0.40

# === 2DCS scan (see 2dcs_geomI.param for convention notes) ===
tau_start = 0.0
tau_end   = -100.0
tau_step  = -0.02
parallel_tau = true
num_trials   = 1

# === Time evolution ===
md_time_start = -100.0
md_time_end   =  100.0
md_timestep   = 0.02
md_integrator = rk4
use_gpu = false

# === Output ===
output_dir = TmFeO3_2DCS_geomII
save_observables = false
