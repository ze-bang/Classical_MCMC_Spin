# Pyrochlore Magnetic Field Scan
# Scans the field strength from 0 to 5 (51 points) with simulated annealing
# at every field value (a parameter sweep; the field_scan_* keys of earlier
# versions were never read, so this file used to run a single zero-field SA).
# Usage: mpirun -np N ./spin_solver field_scan.param

# Simulation Type
system = pyrochlore
simulation_mode = parameter_sweep
sweep_base_simulation = simulated_annealing  # Repeated for each field

# Lattice Size
lattice_size = 8,8,8

# Exchange Interaction Parameters
Jxx = 1.0
Jyy = 1.0
Jzz = 1.0

# g-tensor parameters
gxx = 0.01
gyy = 0.0004
gzz = 1.0
theta = 0.0

# Field Scan Parameters
field_direction = 0,0,1
sweep_parameter = field_strength
sweep_start = 0.0
sweep_end = 5.0
sweep_step = 0.1                    # 50 steps

# Annealing per field point
T_start = 5.0
T_end = 0.001                       # T_end must be > 0 (T_end = 0 never terminated)
T_zero = true                       # finish with a T = 0 quench
annealing_steps = 100000
overrelaxation_rate = 10

# Number of trials per field value
num_trials = 20

# Output
output_dir = PYROCHLORE_field_scan
save_observables = true
